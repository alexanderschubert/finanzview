APP_NAME=FinanzView
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=finanzblick
DB_USERNAME=finanzblick
DB_PASSWORD=CHANGE_ME
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
# E-Mail (nötig für "Passwort vergessen"). Mit MAIL_MAILER=log werden
# Mails nur ins Log geschrieben.
MAIL_FROM_ADDRESS=finanzview@example.com
MAIL_FROM_NAME=FinanzView
