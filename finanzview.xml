<?xml version="1.0"?>
<Container version="2">
  <Name>FinanzView</Name>
  <Repository>gitea.alxserver.de/alexander/finanzview:latest</Repository>
  <Registry>https://gitea.alxserver.de</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>

  <Support>https://gitea.alxserver.de/alexander/finanzview</Support>

  <Project>FinanzView</Project>
  <Overview>
    FinanzView – persönliche Finanzverwaltung auf Basis von Laravel.

    Dieses Template verwendet das fertige FinanzView Docker Image aus der
    privaten Gitea Container Registry.

    PostgreSQL wird separat betrieben und über die DB_* Variablen konfiguriert.
  </Overview>

  <Category>Finance:</Category>

  <WebUI>http://[IP]:[PORT:8080]/</WebUI>

  <TemplateURL>https://gitea.alxserver.de/alexander/finanzview/raw/branch/main/finanzview.xml</TemplateURL>

  <Icon>https://gitea.alxserver.de/alexander/finanzview/raw/branch/main/public/favicon.ico</Icon>

  <Config Name="WebUI Port"
          Target="80"
          Default="8080"
          Mode="tcp"
          Description="Port für die FinanzView Weboberfläche."
          Type="Port"
          Display="always"
          Required="true"
          Mask="false">8080</Config>

  <Config Name="Application URL"
          Target="APP_URL"
          Default="http://[IP]:[PORT:8080]"
          Mode=""
          Description="Öffentliche URL von FinanzView. Bei Verwendung eines Reverse Proxy z.B. https://finanzview.example.com"
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false">http://[IP]:[PORT:8080]</Config>

  <Config Name="Application Key"
          Target="APP_KEY"
          Default=""
          Mode=""
          Description="Laravel APP_KEY. Beispiel: base64:... Einmal erzeugen und anschließend dauerhaft beibehalten."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false"></Config>

  <Config Name="Database Connection"
          Target="DB_CONNECTION"
          Default="pgsql"
          Mode=""
          Description="Datenbanktreiber."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false">pgsql</Config>

  <Config Name="Database Host"
          Target="DB_HOST"
          Default=""
          Mode=""
          Description="Hostname oder IP-Adresse des PostgreSQL-Servers. Beispiel: 192.168.40.100 oder postgres."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false"></Config>

  <Config Name="Database Port"
          Target="DB_PORT"
          Default="5432"
          Mode=""
          Description="PostgreSQL Port."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false">5432</Config>

  <Config Name="Database Name"
          Target="DB_DATABASE"
          Default="finanzblick"
          Mode=""
          Description="Name der PostgreSQL-Datenbank."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false">finanzblick</Config>

  <Config Name="Database User"
          Target="DB_USERNAME"
          Default="finanzblick"
          Mode=""
          Description="PostgreSQL Benutzer."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false">finanzblick</Config>

  <Config Name="Database Password"
          Target="DB_PASSWORD"
          Default=""
          Mode=""
          Description="PostgreSQL Passwort."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="true"></Config>

  <Config Name="Timezone"
          Target="TZ"
          Default="Europe/Berlin"
          Mode=""
          Description="Zeitzone für FinanzView."
          Type="Variable"
          Display="always"
          Required="true"
          Mask="false">Europe/Berlin</Config>

  <Config Name="Storage"
          Target="/var/www/html/storage"
          Default="/mnt/user/appdata/finanzblick/storage"
          Mode="rw"
          Description="Persistenter Speicher für Laravel Storage."
          Type="Path"
          Display="always"
          Required="true"
          Mask="false">/mnt/user/appdata/finanzblick/storage</Config>

  <Config Name="App Data"
          Target="/var/www/html/bootstrap/cache"
          Default="/mnt/user/appdata/finanzblick/bootstrap-cache"
          Mode="rw"
          Description="Persistenter Laravel Bootstrap Cache."
          Type="Path"
          Display="advanced"
          Required="true"
          Mask="false">/mnt/user/appdata/finanzblick/bootstrap-cache</Config>

  <Config Name="OIDC aktivieren"
          Target="OIDC_ENABLED"
          Default="false"
          Mode=""
          Description="Anmeldung über OpenID Connect (z. B. Authentik) aktivieren. Redirect-URI im Provider: APP_URL/auth/oidc/callback"
          Type="Variable"
          Display="always"
          Required="false"
          Mask="false">false</Config>

  <Config Name="OIDC Issuer"
          Target="OIDC_ISSUER"
          Default=""
          Mode=""
          Description="Issuer-URL des Providers. Authentik: https://auth.example.com/application/o/finanzview/"
          Type="Variable"
          Display="always"
          Required="false"
          Mask="false"></Config>

  <Config Name="OIDC Client ID"
          Target="OIDC_CLIENT_ID"
          Default=""
          Mode=""
          Description="Client ID aus dem OAuth2/OpenID-Provider."
          Type="Variable"
          Display="always"
          Required="false"
          Mask="false"></Config>

  <Config Name="OIDC Client Secret"
          Target="OIDC_CLIENT_SECRET"
          Default=""
          Mode=""
          Description="Client Secret aus dem OAuth2/OpenID-Provider."
          Type="Variable"
          Display="always"
          Required="false"
          Mask="true"></Config>

  <Config Name="OIDC Button-Text"
          Target="OIDC_BUTTON_LABEL"
          Default="Mit SSO anmelden"
          Mode=""
          Description="Beschriftung des SSO-Buttons auf der Login-Seite."
          Type="Variable"
          Display="advanced"
          Required="false"
          Mask="false">Mit SSO anmelden</Config>

  <Config Name="OIDC E-Mail vertrauen"
          Target="OIDC_TRUST_EMAIL"
          Default="false"
          Mode=""
          Description="Bestehende Konten auch dann per E-Mail verknüpfen, wenn der Provider email_verified nicht auf true setzt. Nur aktivieren, wenn Benutzer ihre E-Mail im Provider nicht selbst ändern können."
          Type="Variable"
          Display="advanced"
          Required="false"
          Mask="false">false</Config>

</Container>
